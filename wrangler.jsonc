{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "solvely",

  "main": "worker.js",

  "compatibility_date": "2026-08-25",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d101132c3a8340689ab4c1a1934d8d26"
    }
  ]
}
